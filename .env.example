# Service Configuration
SERVICE_NAME=root
SERVICE_PORT=8007
NODE_ENV=development

# Database (Shared PostgreSQL)
DATABASE_URL=postgresql://user:pass@postgres:5432/root_db

# WordPress Configuration (Headless)
WORDPRESS_API_URL=http://wordpress:8008/graphql
WORDPRESS_PREVIEW_SECRET=your_preview_secret_here

# Next.js Configuration
NEXT_PUBLIC_API_URL=http://localhost:8007
NEXTAUTH_URL=http://localhost:8007
NEXTAUTH_SECRET=your_nextauth_secret_here

# Optional: Analytics
NEXT_PUBLIC_GA_ID=
